.nav__overlay { background: linear-gradient(rgba(26, 26, 26, 0.9) 3%, rgba(26, 26, 26, 0)); display: none; height: 60vh; opacity: 1; z-index: 3; }

.mobilenav, .nav__overlay { left: 0px; pointer-events: none; position: fixed; top: 0px; width: 100vw; }

.mobilenav { background-color: var(--blue); clip-path: rect(0px 100% 0px 0px); color: var(--grey); height: 85svh; padding: 20svh 0px 0px 10px; z-index: 20; }

.mobilenav__backdrop { background-color: rgba(0, 0, 0, 0.8); height: 100lvh; left: 0px; opacity: 0; pointer-events: none; position: fixed; top: 0px; transition: opacity 0.2s linear; width: 100vw; z-index: 3; }

.mobilenav__main a { display: block; font-family: SemiSqueezed, serif; font-size: 42px; line-height: 1; padding: 5px 10px; }

