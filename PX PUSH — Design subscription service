section .branding p.lead.short { padding-right: 10vw; position: sticky; top: 8vw; }

section .branding .button { background-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: var(--cream); margin-top: 5vw; padding-left: 1vw; padding-right: 1vw; }

section .branding .button::before { background-color: var(--lightgrey); }

section .branding .button:hover { color: rgb(0, 0, 0) !important; }

@media screen and (max-width: 600px) {
