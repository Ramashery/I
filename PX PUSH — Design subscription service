header .menu { background: transparent; border: 0px; color: inherit; cursor: pointer; display: block; font: inherit; padding: 1.66vw 3vw; position: fixed; right: 0px; top: 0px; z-index: 4; }

@media screen and (max-width: 600px) {
  header .menu { margin-top: 30px; right: 20px; }
}

