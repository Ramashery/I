  100% { transform: translate3d(-7rem, 0px, 0px); }
}

.scanlines { height: 100vh; left: 0px; opacity: 0.25; overflow: hidden; pointer-events: none; position: fixed; top: 0px; width: 100vw; z-index: 22; }

.scanlines::after, .scanlines::before { content: ""; display: block; pointer-events: none; position: absolute; }

.scanlines::before { animation: 8s linear 0s infinite normal none running scanline; background:  0% 0% / 100% 0.6vw rgba(0, 0, 0, 0.7); height: clamp(2px, 0.1vw, 3px); opacity: 0.8; transform: translate3d(0px, -10vh, 0px); width: 100%; will-change: transform; z-index: 22; }

