@media screen and (max-width: 600px) {
  header .nav { display: none; }
  header .logo { padding: 6px 20px; }
}

header .logo svg { height: auto; margin-top: 0.3vw; width: 10vw; }

@media screen and (max-width: 1300px) {
  header .logo svg { margin-top: 6px; width: 115px; }
